  !insertmacro PropelRemoveLegacyExt "pnml"
  !insertmacro PropelRemoveLegacyExt "apnml"
  !insertmacro PropelRemoveLegacyExt "ocdeclare"
  !insertmacro PropelRemoveLegacyExt "reflow"
  !insertmacro PropelRemoveLegacyClass "Table file"
