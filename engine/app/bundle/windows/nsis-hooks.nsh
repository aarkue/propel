!macro NSIS_HOOK_PREINSTALL
  Push $R0
  Push $R1
  Push $R2
  Push $R3
  !insertmacro PropelRemoveLegacy
  !insertmacro PropelRestoreOwnDefault "xes" "propel.xes"
  !insertmacro PropelRestoreOwnDefault "pnml" "propel.pnml"
  !insertmacro PropelRestoreOwnDefault "apnml" "propel.apnml"
  !insertmacro PropelRestoreOwnDefault "ocdeclare" "propel.ocdeclare"
  !insertmacro PropelRestoreOwnDefault "reflow" "propel.reflow"
  Pop $R3
  Pop $R2
  Pop $R1
  Pop $R0
!macroend

!macro NSIS_HOOK_POSTINSTALL
  !insertmacro PropelRegisterOpenWith "json" "JSON file"
  !insertmacro PropelRegisterOpenWith "xml" "XML file"
  !insertmacro PropelRegisterOpenWith "csv" "CSV file"
  !insertmacro PropelRegisterOpenWith "tsv" "TSV file"
  !insertmacro PropelRegisterOpenWith "xlsx" "Excel workbook"
  !insertmacro PropelRegisterOpenWith "parquet" "Parquet file"
  !insertmacro PropelRegisterOpenWith "db" "Database file"
  !insertmacro PropelRegisterOpenWith "sqlite" "SQLite database"
  !insertmacro PropelRegisterOpenWith "sqlite3" "SQLite database"
  !insertmacro PropelRegisterOpenWith "gz" "Gzip archive"
  !insertmacro PropelRegisterOpenWith "zip" "ZIP archive"
  System::Call "shell32::SHChangeNotify(i 0x08000000, i 0, p 0, p 0)"
!macroend

!macro NSIS_HOOK_PREUNINSTALL
  Push $R0
  Push $R1
  Push $R2
  Push $R3
  !insertmacro PropelRemoveLegacy
  !insertmacro PropelUnregisterOpenWith "json"
  !insertmacro PropelUnregisterOpenWith "xml"
  !insertmacro PropelUnregisterOpenWith "csv"
  !insertmacro PropelUnregisterOpenWith "tsv"
  !insertmacro PropelUnregisterOpenWith "xlsx"
  !insertmacro PropelUnregisterOpenWith "parquet"
  !insertmacro PropelUnregisterOpenWith "db"
  !insertmacro PropelUnregisterOpenWith "sqlite"
  !insertmacro PropelUnregisterOpenWith "sqlite3"
  !insertmacro PropelUnregisterOpenWith "gz"
  !insertmacro PropelUnregisterOpenWith "zip"
  !insertmacro PropelKeepOtherDefault "xes" "propel.xes"
  !insertmacro PropelKeepOtherDefault "pnml" "propel.pnml"
  !insertmacro PropelKeepOtherDefault "apnml" "propel.apnml"
  !insertmacro PropelKeepOtherDefault "ocdeclare" "propel.ocdeclare"
  !insertmacro PropelKeepOtherDefault "reflow" "propel.reflow"
  Pop $R3
  Pop $R2
  Pop $R1
  Pop $R0
!macroend

!macro NSIS_HOOK_POSTUNINSTALL
  Push $R0
  !insertmacro PropelTidyOwn "xes" "propel.xes"
  !insertmacro PropelTidyOwn "pnml" "propel.pnml"
  !insertmacro PropelTidyOwn "apnml" "propel.apnml"
  !insertmacro PropelTidyOwn "ocdeclare" "propel.ocdeclare"
  !insertmacro PropelTidyOwn "reflow" "propel.reflow"
  Pop $R0
  System::Call "shell32::SHChangeNotify(i 0x08000000, i 0, p 0, p 0)"
!macroend
