!macro PropelRemoveLegacyClass CLASS
  ReadRegStr $R0 SHCTX "Software\Classes\${CLASS}\shell\open\command" ""
  ${If} $R0 == '$INSTDIR\propel-tauri.exe "%1"'
    DeleteRegKey SHCTX "Software\Classes\${CLASS}"
  ${EndIf}
!macroend

; APP_ASSOCIATE backs up the current default. When that is already Propel's class (an update
; over an install), put the real previous default back first so the backup stays correct.
!macro PropelRestoreOwnDefault EXT CLASS
  ReadRegStr $R0 SHCTX "Software\Classes\.${EXT}" ""
  ${If} $R0 == "${CLASS}"
    ReadRegStr $R1 SHCTX "Software\Classes\.${EXT}" "${CLASS}_backup"
    ${If} $R1 == "${CLASS}"
    ${OrIf} $R1 == ""
      DeleteRegValue SHCTX "Software\Classes\.${EXT}" ""
    ${Else}
      WriteRegStr SHCTX "Software\Classes\.${EXT}" "" $R1
    ${EndIf}
  ${EndIf}
!macroend

; APP_UNASSOCIATE writes the backup back unconditionally. Keep a default the user picked
; after installing Propel.
!macro PropelKeepOtherDefault EXT CLASS
  ReadRegStr $R0 SHCTX "Software\Classes\.${EXT}" ""
  ${If} $R0 != "${CLASS}"
    WriteRegStr SHCTX "Software\Classes\.${EXT}" "${CLASS}_backup" $R0
  ${EndIf}
!macroend

!macro PropelTidyOwn EXT CLASS
  ReadRegStr $R0 SHCTX "Software\Classes\.${EXT}" ""
  ${If} $R0 == ""
    DeleteRegValue SHCTX "Software\Classes\.${EXT}" ""
  ${EndIf}
  DeleteRegValue SHCTX "Software\Classes\.${EXT}" "${CLASS}_backup"
  DeleteRegKey /ifempty SHCTX "Software\Classes\.${EXT}"
!macroend

!macro PropelRegisterOpenWith EXT DESCRIPTION
  WriteRegStr SHCTX "Software\Classes\propel.openwith.${EXT}" "" "${DESCRIPTION}"
  WriteRegStr SHCTX "Software\Classes\propel.openwith.${EXT}\DefaultIcon" "" '"$INSTDIR\${MAINBINARYNAME}.exe",0'
  WriteRegStr SHCTX "Software\Classes\propel.openwith.${EXT}\shell\open\command" "" '"$INSTDIR\${MAINBINARYNAME}.exe" "%1"'
  WriteRegStr SHCTX "Software\Classes\.${EXT}\OpenWithProgids" "propel.openwith.${EXT}" ""
!macroend

!macro PropelUnregisterOpenWith EXT
  ReadRegStr $R0 SHCTX "Software\Classes\propel.openwith.${EXT}\shell\open\command" ""
  ${If} $R0 == '"$INSTDIR\${MAINBINARYNAME}.exe" "%1"'
    DeleteRegKey SHCTX "Software\Classes\propel.openwith.${EXT}"
    DeleteRegValue SHCTX "Software\Classes\.${EXT}\OpenWithProgids" "propel.openwith.${EXT}"
    DeleteRegKey /ifempty SHCTX "Software\Classes\.${EXT}\OpenWithProgids"
    DeleteRegKey /ifempty SHCTX "Software\Classes\.${EXT}"
  ${EndIf}
!macroend

