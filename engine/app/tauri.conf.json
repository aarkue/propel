{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "propel",
  "version": "0.5.3",
  "identifier": "eu.aarkue.propel",
  "build": {
    "beforeDevCommand": "pnpm --filter @r4pm/studio dev:tauri",
    "beforeBuildCommand": "pnpm --filter @r4pm/studio build:tauri",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../apps/studio/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "propel",
        "width": 1200,
        "height": 800,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "xes"
        ],
        "name": "XES event log",
        "description": "XES event log",
        "role": "Editor",
        "exportedType": {
          "identifier": "eu.aarkue.propel.xes",
          "conformsTo": [
            "public.xml"
          ]
        }
      },
      {
        "ext": [
          "pnml"
        ],
        "name": "PNML Petri net",
        "description": "PNML Petri net",
        "role": "Editor",
        "exportedType": {
          "identifier": "eu.aarkue.propel.pnml",
          "conformsTo": [
            "public.xml"
          ]
        }
      },
      {
        "ext": [
          "apnml"
        ],
        "name": "Accepting Petri net",
        "description": "Accepting Petri net",
        "role": "Editor",
        "exportedType": {
          "identifier": "eu.aarkue.propel.apnml",
          "conformsTo": [
            "public.xml"
          ]
        }
      },
      {
        "ext": [
          "ocdeclare"
        ],
        "name": "OC-DECLARE model",
        "description": "OC-DECLARE model",
        "role": "Editor",
        "exportedType": {
          "identifier": "eu.aarkue.propel.ocdeclare",
          "conformsTo": [
            "public.json"
          ]
        }
      },
      {
        "ext": [
          "reflow"
        ],
        "name": "Reflow mapping",
        "description": "Reflow mapping",
        "role": "Editor",
        "exportedType": {
          "identifier": "eu.aarkue.propel.reflow",
          "conformsTo": [
            "public.json"
          ]
        }
      },
      {
        "ext": [
          "json"
        ],
        "name": "JSON file",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": [
          "xml"
        ],
        "name": "XML file",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": [
          "csv"
        ],
        "name": "CSV file",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": [
          "tsv"
        ],
        "name": "TSV file",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": [
          "xlsx"
        ],
        "name": "Excel workbook",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": [
          "parquet"
        ],
        "name": "Parquet file",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": [
          "db"
        ],
        "name": "Database file",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": [
          "sqlite"
        ],
        "name": "SQLite database",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": [
          "sqlite3"
        ],
        "name": "SQLite database",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": [
          "gz"
        ],
        "name": "Gzip archive",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": [
          "zip"
        ],
        "name": "ZIP archive",
        "role": "Viewer",
        "rank": "Alternate"
      }
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhFQkE4OEE2REFDRkYxNUMKUldSYzhjL2Fwb2k2am5JR2hpaUxqWVc1MVRVd1Q0VDhOdUNwbU5WVG1rOHBjdDhGeVUvQWQrZ2QK",
      "endpoints": [
        "https://github.com/aarkue/propel/releases/latest/download/latest.json"
      ]
    }
  }
}
